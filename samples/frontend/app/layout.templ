package app

// htmxConfig makes htmx swap 422 responses, which the handlers use for
// validation errors; other 4xx and 5xx responses are still not swapped.
const htmxConfig = `{"responseHandling": [
	{"code": "204", "swap": false},
	{"code": "422", "swap": true},
	{"code": "[23]..", "swap": true},
	{"code": "[45]..", "swap": false, "error": true}
]}`

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
			<main class="mx-auto max-w-xl px-4 py-16">
				{ children... }
			</main>
		</body>
	</html>
}
